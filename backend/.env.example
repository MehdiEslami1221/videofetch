# Set values in IntelliJ Run Configuration environment variables, not in Git.
VIDEOFETCH_PROXY_URL=http://127.0.0.1:10808
VIDEOFETCH_JS_RUNTIME=node
VIDEOFETCH_STORAGE_DIR=./data/jobs
VIDEOFETCH_TOOLS_DIR=./tools/bin

